# 서버: sudo install -D -m 640 -o root -g docker deploy/app.env.example /etc/blog/app.env 후 값 입력 (ledger 와 같은 권한)
# docker-compose.yml 의 env_file 로 컨테이너에 들어가고, globals.properties 의 ${...} 가 읽는다.
BLOG_DB_URL=jdbc:postgresql://127.0.0.1:5432/blog
BLOG_DB_USER=blog_app
BLOG_DB_PASSWORD=
# /blog/admin/login 의 관리자 비밀번호. 비워 두면 로그인할 수 없다. 길게 (예: openssl rand -base64 18)
BLOG_ADMIN_PASSWORD=
